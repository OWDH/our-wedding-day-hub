# Our Wedding Day Hub — server secrets
# These are Firebase Functions secrets, not Vite env vars.
# Set with: firebase functions:secrets:set NAME
# Deployed functions will not start Stripe checkout or webhooks without the Stripe keys.

# Stripe (required for membership checkout)
# Use a sk_live_ key in production and a sk_test_ key only in test mode.
# A live/test mismatch is a common cause of "This payment link is not available".
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (required for /stripeWebhook and /api/stripe-webhook)
# Create the endpoint in Stripe Dashboard → Developers → Webhooks:
#   https://us-central1-ourweddingdayhub.cloudfunctions.net/stripeWebhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         invoice.paid, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Already used by the existing Cloud Function
RESEND_API_KEY=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_REFRESH_TOKEN=
CONSTANT_CONTACT_VENDOR_LIST_ID=
CONSTANT_CONTACT_COUPLE_LIST_ID=
